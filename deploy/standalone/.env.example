# Copy to .env. Choose unique storage credentials before the first start.
STORAGE_ACCESS_KEY=openseo
STORAGE_SECRET_KEY=replace-with-a-long-random-secret
# password: email and password accounts. The first visitor creates the
# admin account; invitations add the rest.
# local_noauth: no sign-in and one admin user, as the old Docker image ran;
# only for private networks.
AUTH_MODE=password
# The public URL of this installation, in either mode.
BETTER_AUTH_URL=http://localhost:3001
PORT=3001
# Optional feature credentials; these are set at initialization, never compiled.
DATAFORSEO_API_KEY=
# Claude powers SAM, website research and prompt suggestions.
ANTHROPIC_API_KEY=
# Optional. Default: claude-sonnet-5-5
ANTHROPIC_MODEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONTEXT_API_KEY=
# Optional: free Lighthouse checks through Google PageSpeed Insights
# instead of DataForSEO.
GOOGLE_PAGESPEED_API_KEY=
# Optional: at least 32 random characters. Encrypts saved Shopify crawler
# signatures for site audits.
CRAWLER_ACCESS_SECRET=
